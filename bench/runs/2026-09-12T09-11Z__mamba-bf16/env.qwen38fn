# =============================================================================
#  Site config for the spark-4ab3 / spark-8972 pair.
#  Recipe: MiaAI-Lab/Qwen3.8-Flash-Next-Dual-DGX-Sparks @ c2325b2 (vLLM).
#
#  Only SITE-specific values deviate from .env.sample. Every serving knob is
#  left at the recipe's shipped default so the first boot reproduces the
#  upstream measurements; tuning comes after the first bench run.
# =============================================================================

# ---- Cluster networking -----------------------------------------------------
# SITE: our CX7 pair is link-local autoconf, not the sample's 10.0.0.0/24.
# These are also the ssh/rsync targets, so the 126 GiB worker sync and NCCL
# both ride the 200 Gb rail rather than the 1 GbE management LAN.
HEAD_IP="169.254.240.100"
WORKER_IP="169.254.16.74"
WORKER_USER=""                  # same user (nvidia) on both nodes

# ---- Interfaces / HCA -------------------------------------------------------
# SITE: this pair is NOT cross-wired -- BOTH nodes are cabled on port 1 (f1).
# f0 is DOWN on both boxes, so the sample's f0 defaults never rendezvous.
IFACE="enp1s0f1np1"
WORKER_IFACE="enp1s0f1np1"
IB_HCA="=rocep1s0f1"
WORKER_IB_HCA="=rocep1s0f1"
IB_GID_INDEX=3

# ---- Model ------------------------------------------------------------------
MODEL_ID="nvidia/Qwen3.8-Flash-Next-NVFP4"
SERVED_MODEL_NAME="Qwen3.8-Flash-Next-NVFP4"

# ---- Serving parameters (all recipe defaults) -------------------------------
MAX_MODEL_LEN=262144            # native window; no YaRN
YARN_ENABLE=false
YARN_FACTOR=4.0
GPU_MEMORY_UTILIZATION=0.835
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=auto

# SITE: 8888 is firewalled on these boxes; 8000 is the port the LAN can reach,
# and it is what bench/, Prometheus and the OpenCode config all target.
PORT=8000

# ---- Parallelism (recipe defaults) ------------------------------------------
TENSOR_PARALLEL_SIZE=2
ENABLE_EXPERT_PARALLEL=true
MM_ENCODER_TP_MODE=data
MTP_NUM_SPECULATIVE_TOKENS=3

# ---- Image / misc (recipe defaults) -----------------------------------------
IMAGE="vllm/vllm-openai:qwen38-flash-next"
PLE_OFFLOAD=false               # only ~5 GiB RAM free here; must stay false
FP8_DENSE=false
QSA_PROFILE=stock
REQUIRE_IDLE_GPU=true
NFS_SHARE=false                 # 2.1T free on each node; keep the nodes decoupled
MASTER_PORT=50000
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# ---- Draft vocabulary (pinned 2026-09-06) -----------------------------------
# The 16,384-id draft vocabulary ranked on our own opencode traffic (99.4% token
# coverage): +21% single-stream decode, +4% at c=5. start.sh mounts it at
# /etc/vllm-draft-vocab.txt and adds "use_local_argmax_reduction":true to the
# speculative config when this is set.
#
# THIS LINE IS LOAD-BEARING. The 2026-09-06 arm that measured the +21% was launched
# with MTP_DRAFT_VOCAB passed on the command line, so nothing on disk recorded it --
# a plain `./start.sh` would have silently come back up with the full vocabulary and
# given back the 21%, looking like a bad boot rather than a lost setting. Pinned here
# so the file alone reproduces what is running.
MTP_DRAFT_VOCAB="/home/nvidia/qwen38-fn-vllm/draft_vocab_opencode_16384.txt"

# ---- Extra vLLM args --------------------------------------------------------
# Appended last and verbatim to the serve line by start.sh (line 663).
#
# --async-scheduling overlaps the scheduler's CPU work with the GPU forward pass. We
# ran it on every DeepSeek arm (it is in every manifest under bench/runs/2026-08-*)
# and it was dropped in the port to this recipe, which has no knob for it. It targets
# exactly the bottleneck we measured on this box -- decode is launch-bound, steps/s
# pinned near 15 at 94-96% SM utilisation -- and bilikaz measured +9-12% at c=4-5 on
# the same hardware, which is where our curve is weakest.
EXTRA_VLLM_ARGS="--async-scheduling --mamba-ssm-cache-dtype bfloat16"